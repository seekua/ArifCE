<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arifce-dashboard</ToolCommandName>
    <PackageId>ArifCE.Dashboard</PackageId>
    <Version>0.5.0</Version>
    <Authors>ArifCE Contributors</Authors>
    <Description>Local-only dashboard for ArifCE project intelligence.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/seekua/ArifCE</PackageProjectUrl>
    <RepositoryUrl>https://github.com/seekua/ArifCE.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArifCE.Dashboard</AssemblyName>
    <RootNamespace>ArifCE.Dashboard</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArifCE.Infrastructure/ArifCE.Infrastructure.csproj" />
    <None Include="../../assets/tabler/tabler.min.css" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets/tabler" />
    <None Include="../../assets/arifce-dashboard.css" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets" />
    <None Include="../../assets/dashboard-daily-brief.js" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets" />
    <None Include="../../assets/dashboard-activity-timeline.js" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets" />
    <None Include="../../assets/dashboard-provider-health.js" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets" />
    <None Include="../../assets/dashboard-executive-summary.js" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets" />
    <None Include="../../assets/ArifCE.svg" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/assets" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>
