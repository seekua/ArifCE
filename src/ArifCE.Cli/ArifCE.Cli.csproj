<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arifce</ToolCommandName>
    <PackageId>ArifCE.Cli</PackageId>
    <Title>ArifCE Project Intelligence CLI</Title>
    <Version>0.6.0</Version>
    <Authors>ArifCE Contributors</Authors>
    <Description>Local-first project intelligence, continuity, evidence, handoff, and refactor tracking for software engineering agents.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/seekua/ArifCE</PackageProjectUrl>
    <RepositoryUrl>https://github.com/seekua/ArifCE.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>project-intelligence;ai-agents;developer-tools;cli;continuity</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArifCE.Infrastructure/ArifCE.Infrastructure.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>
